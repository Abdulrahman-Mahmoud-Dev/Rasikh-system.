# Copy this file to .env before running Docker Compose.
# Keep .env local: it is ignored by Git.

POSTGRES_DB=rasikh_dev
POSTGRES_USER=rasikh_app
# Use a long random alphanumeric value here so the local URL needs no URL encoding.
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_ALPHANUMERIC_VALUE

# Generate a separate random value of at least 32 characters.
COOKIE_SECRET=CHANGE_THIS_TO_A_DIFFERENT_RANDOM_SECRET_WITH_32_OR_MORE_CHARACTERS

# Local development frontend, for example: python -m http.server 5500
CORS_ORIGIN=http://localhost:5500
PUBLIC_APP_URL=http://localhost:5500
BACKEND_PORT=3000

# Optional external integrations are intentionally omitted until configured.
# When ready, add the following variables to the backend service in compose.yaml:
# GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# EMAILJS_INVITATION_TEMPLATE_ID=template_...
# EMAILJS_ACCOUNT_TEMPLATE_ID=template_...
# EMAILJS_PRIVATE_KEY=... (server secret only)
