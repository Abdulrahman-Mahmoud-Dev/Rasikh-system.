# Application
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Database
DATABASE_URL=postgresql://rasikh_app:CHANGE_ME@localhost:5432/rasikh_dev

# Security
COOKIE_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Sessions
SESSION_TTL_HOURS=12

# Frontend
CORS_ORIGIN=http://localhost:5500
PUBLIC_APP_URL=http://localhost:5500

# EmailJS: reuse the existing Rasikh EmailJS service.
# The public key and service ID are identifiers, not secret credentials.
EMAILJS_PUBLIC_KEY=R-1PwjvGMVEsTg1j5
EMAILJS_SERVICE_ID=service_5lcvg4g

# Create these two templates in EmailJS and put their template IDs here.
# Invitation template variables:
# to_email, to_name, subject, email_title, message, invitation_url,
# organization_name, role_name, scope_name, inviter_name, expires_at, action_label
EMAILJS_INVITATION_TEMPLATE_ID=template_REPLACE_WITH_INVITATION_TEMPLATE_ID

# Account template variables:
# to_email, to_name, subject, email_title, message, action_url, action_label
EMAILJS_ACCOUNT_TEMPLATE_ID=template_REPLACE_WITH_ACCOUNT_TEMPLATE_ID

# Optional EmailJS private key. Store it only in the backend host's secrets.
EMAILJS_PRIVATE_KEY=

# Legacy OTP API only (not used by the current sign-in screen).
# RESEND_API_KEY=
# EMAIL_FROM=

# Google Identity Services: create a Web OAuth client in Google Cloud Console.
# Add the exact GitHub Pages origin to Authorized JavaScript origins.
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# Logging
LOG_LEVEL=info

# Production requirements (for a frontend such as GitHub Pages calling a separate backend origin):
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none
# CORS_ORIGIN=https://YOUR-ACCOUNT.github.io
# PUBLIC_APP_URL=https://YOUR-ACCOUNT.github.io/YOUR-REPOSITORY
