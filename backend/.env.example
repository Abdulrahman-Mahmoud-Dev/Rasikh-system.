# Application
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Database
DATABASE_URL=postgresql://rasikh_app:CHANGE_ME@localhost:5432/rasikh_dev

# Security
COOKIE_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
COOKIE_SECURE=false

# Sessions
SESSION_TTL_HOURS=12

# Frontend
CORS_ORIGIN=http://localhost:5500

# Email delivery (Resend)
# Store the real API key as a secret in the hosting provider, never in Git.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Rasikh <no-reply@your-verified-domain.example>

# Logging
LOG_LEVEL=info
